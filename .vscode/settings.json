{
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "cmake.configureOnOpen": true,
    "python.analysis.extraPaths": [
        "./src/PyCXpress"
    ],
    "files.associations": {
        "tuple": "cpp",
        "array": "cpp",
        "ostream": "cpp",
        "type_traits": "cpp",
        "optional": "cpp",
        "*.tcc": "cpp",
        "random": "cpp",
        "fstream": "cpp",
        "functional": "cpp",
        "istream": "cpp",
        "limits": "cpp",
        "sstream": "cpp",
        "streambuf": "cpp",
        "complex": "cpp",
        "stdexcept": "cpp"
    },
    "debugpy.showPythonInlineValues": true
}
